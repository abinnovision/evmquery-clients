{
	"name": "@evmquery/react",
	"version": "1.0.0",
	"description": "React hooks for querying evmquery.com, built on top of @evmquery/sdk.",
	"keywords": [
		"evmquery",
		"evm",
		"ethereum",
		"react",
		"hooks",
		"sdk",
		"smart-contracts",
		"cel",
		"suspense"
	],
	"homepage": "https://github.com/abinnovision/evmquery-clients/tree/main/packages/react#readme",
	"repository": {
		"url": "https://github.com/abinnovision/evmquery-clients",
		"directory": "packages/react"
	},
	"license": "Apache-2.0",
	"author": {
		"name": "abi group GmbH",
		"email": "info@abigroup.io",
		"url": "https://abigroup.io/"
	},
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"main": "./dist/index.cjs",
	"types": "./dist/index.d.cts",
	"files": [
		"dist",
		"README.md",
		"LICENSE.md"
	],
	"scripts": {
		"build": "tsdown",
		"format:check": "prettier --check '{{src,test}/**/*,*}.{{t,j}s{,x},json{,5},md,y{,a}ml}'",
		"format:fix": "prettier --write '{{src,test}/**/*,*}.{{t,j}s{,x},json{,5},md,y{,a}ml}'",
		"lint:check": "eslint '{{src,test}/**/*,*}.{t,j}s{,x}'",
		"lint:fix": "eslint '{{src,test}/**/*,*}.{t,j}s{,x}' --fix",
		"test-unit": "vitest run",
		"test-unit:watch": "vitest watch",
		"typecheck": "tsc --noEmit"
	},
	"lint-staged": {
		"{{src,test}/**/*,*}.{{t,j}s{,x},json{,5},md,y{,a}ml}": [
			"prettier --write"
		],
		"{src/**/*,*}.{t,j}s{,x}": [
			"eslint --fix"
		]
	},
	"dependencies": {
		"@evmquery/sdk": "workspace:^"
	},
	"devDependencies": {
		"@abinnovision/eslint-config-base": "^3.4.2",
		"@abinnovision/prettier-config": "^2.2.0",
		"@internal/tsconfig": "workspace:^",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"eslint": "^10.8.0",
		"jsdom": "^30.0.1",
		"prettier": "^3.9.6",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tsdown": "^0.22.14",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"react": ">=19"
	},
	"publishConfig": {
		"access": "public",
		"npm": true,
		"npmAccess": "public"
	}
}
